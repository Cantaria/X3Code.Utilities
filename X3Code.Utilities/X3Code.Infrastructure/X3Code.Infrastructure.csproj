<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>X3Code.Infrastructure</PackageId>
    <Authors>X3-Code</Authors>
    <Company>X3-Code</Company>
    <Product>X3Code.Infrastructure</Product>
    <Description>Contains the unit of work repository pattern</Description>
    <Copyright>MIT</Copyright>
    <PackageProjectUrl>https://github.com/Cantaria/X3Code.Utilities</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Cantaria/X3Code.Utilities</RepositoryUrl>
    <RepositoryType>GIT</RepositoryType>
    <AssemblyVersion>1.10.1</AssemblyVersion>
    <FileVersion>1.10.1</FileVersion>
    <Version>1.3.1</Version>
    <PackageIcon>x3code_logo.png</PackageIcon>
    <PackageIconUrl />
    <PackageVersion>1.10.1</PackageVersion>
    <PackageReleaseNotes>nuget updates</PackageReleaseNotes>
    <Title>X3-Code Infrastructure</Title>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\x3code_logo.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\X3Code.Utils\Extensions\DataTableExtension.cs">
      <Link>Extensions\DataTableExtension.cs</Link>
    </Compile>
  </ItemGroup>

</Project>
