<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>X3Code.Infrastructure.Mobile</PackageId>
        <Product>X3Code.Infrastructure.Mobile</Product>
        <Title>X3-Code Infrastructure Mobile</Title>
        <Description>The X3Code repository pattern built against EF Core Sqlite, for mobile use</Description>
        <!-- Einzige Versionsangabe; AssemblyVersion, FileVersion und PackageVersion leiten sich davon ab. -->
        <Version>1.10.2</Version>
        <PackageReleaseNotes>nuget updates</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
        <!-- Hebt das native SQLite ueber die verwundbare 2.1.11 (GHSA-2m69-gcr7-jv3q). -->
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>
