<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <NoWarn>InProgress</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.EntityFrameworkCore" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
      <!-- Pin gegen GHSA-2m69-gcr7-jv3q, Version steht in Directory.Packages.props -->
      <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
      <PackageReference Include="Microsoft.NET.Test.Sdk" />
      <PackageReference Include="xunit" />
      <PackageReference Include="xunit.runner.visualstudio">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\X3Code.Repository\X3Code.Repository.csproj" />
    </ItemGroup>

  <!--
    Geteilter Test-Helfer. Testprojekte sind IsPackable=false und werden von niemandem
    referenziert, deshalb braucht dieser Link - anders als die geteilten Bibliotheksquellen -
    keine Namespace- oder Sichtbarkeits-Sonderbehandlung.
  -->
  <ItemGroup>
    <Compile Include="..\TestSupport\InterfaceContract.cs">
      <Link>TestSupport\InterfaceContract.cs</Link>
    </Compile>
  </ItemGroup>

</Project>
