<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Central Package Management verlangt eindeutige Quellen, sonst meldet der Restore NU1507.
    Die Quellen werden hier explizit gesetzt, damit der Restore auf jeder Maschine und in der
    CI gleich aufloest. Zugangsdaten fuer 'github' bleiben im Benutzerprofil bzw. in den
    CI-Secrets - hier stehen keine.
  -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="github" value="https://nuget.pkg.github.com/X3-Code/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <!-- Die eigenen Pakete kommen ausschliesslich aus GitHub Packages. -->
    <packageSource key="github">
      <package pattern="X3Code.*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
